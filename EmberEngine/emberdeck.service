[Unit]
Description=Ember Deck runtime
# Plexamp is preferred but is not required for GPIO, Bluetooth, MPRIS, or LEDs.
Wants=plexamp.service
After=plexamp.service

[Service]
Type=simple
WorkingDirectory=%h/EmberDeck
Environment=PYTHONUNBUFFERED=1

ExecStart=%h/EmberDeck/run_foundry.sh

Restart=on-failure
RestartSec=10
TimeoutStopSec=25
# Keep Foundry and every supervised worker in one shutdown boundary.
KillMode=control-group

[Install]
WantedBy=default.target

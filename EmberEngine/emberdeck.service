[Unit]
Description=Ember Deck runtime
# Plexamp is both a playback source and the local browser UI backend.
Requires=plexamp.service
After=plexamp.service

[Service]
Type=simple
WorkingDirectory=%h/EmberDeck
Environment=PYTHONUNBUFFERED=1

# Do not start workers until Plexamp's application process is ready.
ExecStartPre=%h/EmberDeck/wait_for_plexamp.sh
ExecStart=%h/EmberDeck/run_foundry.sh

Restart=on-failure
RestartSec=10
TimeoutStopSec=25
# Keep Foundry and every supervised worker in one shutdown boundary.
KillMode=control-group

[Install]
WantedBy=default.target
